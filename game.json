      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": "const dt = gdjs.evtTools.runtimeScene.getElapsedTimeInSeconds(runtimeScene);\n\nif (!global.CoreMechanics) {\n  if (typeof require !== 'undefined') {\n    try {\n      global.CoreMechanics = require('./js/core_mechanics.js');\n    } catch (e) {\n      console.error(e);\n    }\n  }\n  if (!global.CoreMechanics && typeof document !== 'undefined') {\n    let scriptTag = document.getElementById('core-mechanics-script');\n    if (!scriptTag) {\n      scriptTag = document.createElement('script');\n      scriptTag.id = 'core-mechanics-script';\n      scriptTag.src = 'js/core_mechanics.js';\n      scriptTag.async = false;\n      document.head.appendChild(scriptTag);\n    }\n  }\n  return;\n}\n\nif (!global._memoryManager) {\n  global._memoryManager = new global.CoreMechanics.MemoryManager(100.0, 2.5);\n}\n\nglobal._memoryManager.updateMemoryLeak(dt, runtimeScene);\n\nconst cacheList = runtimeScene.getObjects('Cache');\nif (cacheList.length > 0) {\n  const cache = cacheList[0];\n  const platformerBehavior = cache.getBehavior('PlatformerObject');\n  const inputManager = runtimeScene.getGame().getInputManager();\n  \n  if (inputManager.isKeyPressed('Left')) {\n    platformerBehavior.simulateControl('Left');\n    if (cache.setFlippedX) cache.setFlippedX(true);\n  }\n  if (inputManager.isKeyPressed('Right')) {\n    platformerBehavior.simulateControl('Right');\n    if (cache.setFlippedX) cache.setFlippedX(false);\n  }\n  if (inputManager.isKeyPressed('Up')) {\n    platformerBehavior.simulateControl('Jump');\n  }\n  \n  if (gdjs.evtTools.input.wasKeyJustPressed(runtimeScene, 'x') || gdjs.evtTools.input.wasKeyJustPressed(runtimeScene, 'X')) {\n    const floppy = runtimeScene.createObject('Disquete');\n    if (floppy) {\n      const initialX = cache.getX() + cache.getWidth() / 2;\n      const initialY = cache.getY() + cache.getHeight() / 2;\n      const velocity = 650;\n      const facingLeft = cache.isFlippedX ? cache.isFlippedX() : false;\n      const angle = facingLeft ? -135 : -45;\n      \n      floppy.setPosition(initialX, initialY);\n      floppy._customPhysics = {\n        x0: initialX,\n        y0: initialY,\n        v0: velocity,\n        angleDegrees: angle,\n        timeElapsed: 0\n      };\n    }\n  }\n  \n  const ramSticks = runtimeScene.getObjects('RAM_Stick');\n  for (let i = 0; i < ramSticks.length; i++) {\n    const ramStick = ramSticks[i];\n    if (gdjs.RuntimeObject.collisionTest(cache, ramStick, false)) {\n      ramStick.deleteFromScene(runtimeScene);\n      global.restoreIntegrity(runtimeScene);\n    }\n  }\n}\n\nconst floppies = runtimeScene.getObjects('Disquete');\nfor (let i = 0; i < floppies.length; i++) {\n  const floppy = floppies[i];\n  if (floppy._customPhysics) {\n    floppy._customPhysics.timeElapsed += dt;\n    const traj = global.CoreMechanics.LegacyHardwarePhysics.calculateFloppyTrajectory(\n      floppy._customPhysics.x0,\n      floppy._customPhysics.y0,\n      floppy._customPhysics.v0,\n      floppy._customPhysics.angleDegrees,\n      floppy._customPhysics.timeElapsed,\n      980\n    );\n    floppy.setPosition(traj.x, traj.y);\n    floppy.setAngle(traj.rotationAngle);\n    \n    if (traj.y > 2000 || traj.x < -500 || traj.x > 2500) {\n      floppy.deleteFromScene(runtimeScene);\n    }\n  }\n}\n\nconst bugs = runtimeScene.getObjects('Bug');\nfor (let i = 0; i < floppies.length; i++) {\n  const floppy = floppies[i];\n  for (let j = 0; j < bugs.length; j++) {\n    const bug = bugs[j];\n    if (gdjs.RuntimeObject.collisionTest(floppy, bug, false)) {\n      floppy.deleteFromScene(runtimeScene);\n      bug.deleteFromScene(runtimeScene);\n      break;\n    }\n  }\n}\n\nconst hudList = runtimeScene.getObjects('HUD_Text');\nif (hudList.length > 0) {\n  let integrityVal = 100;\n  const globalVars = runtimeScene.getGame().getVariables();\n  if (globalVars.has('Integridad_Datos')) {\n    integrityVal = globalVars.get('Integridad_Datos').getAsNumber();\n  }\n  hudList[0].setString('Integridad de Datos: ' + Math.round(integrityVal) + '%');\n}",
          "parameterObjects": ""
